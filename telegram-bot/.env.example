# Copy to .env (git-ignored) or set these as environment variables.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Base URL of the Coperti REST API
COPERTI_API_URL=http://localhost:8080/api

# Shared secret for the backend's /api/bot endpoints. Must equal the backend's coperti.bot.token
# (set it there as the COPERTI_BOT_TOKEN environment variable). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COPERTI_BOT_TOKEN=

# Who may use the bot is no longer configured here: link employees to Telegram accounts in the backend
# (a one-time code via POST /api/telegram-account/employee/{id}/link-code, or the id via PUT /api/telegram-account).
